# Database Configuration (REQUIRED)
# For local development, use:
MONGO_URL=mongodb://localhost:27017/lms_db
# For MongoDB Atlas cloud, use:
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Configuration (REQUIRED)
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters-required
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server Configuration (REQUIRED)
PORT=8082
NODE_ENV=development
RATE_LIMIT_ENABLED=false

# Logging Configuration (OPTIONAL)
# Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# CORS Configuration (REQUIRED)
# Comma-separated list of allowed origins
# Use * to allow all origins (NOT recommended for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# SCORM Configuration (REQUIRED)
SCORM_STORAGE_PROVIDER=local
SCORM_STORAGE_PATH=./scorm-content
SCORM_MAX_PACKAGE_SIZE=104857600
SCORM_SESSION_TIMEOUT=1800

# AWS S3 / Cloud Storage Configuration (OPTIONAL - Required if SCORM_STORAGE_PROVIDER=s3)
# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=lms-scorm-content
# Optional: Custom S3 endpoint (for Digital Ocean Spaces, MinIO, etc.)
# AWS_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# CDN Configuration (OPTIONAL - for serving static content)
CDN_ENABLED=false
CDN_URL=https://cdn.yourdomain.com
CDN_SCORM_PATH=/scorm

# Redis Configuration (REQUIRED for SCORM session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
