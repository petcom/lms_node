{
  "name": "lms-api",
  "version": "1.0.0",
  "description": "Learning Management System - Production-ready RESTful API for school management",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.1",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "start:staging": "pm2 start ecosystem.config.js --env staging",
    "server": "nodemon server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "dev:local": "node -r dotenv-safe/config server.js dotenv_config_path=.env.local",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "NODE_ENV=test jest --coverage --runInBand",
    "test:unit": "NODE_ENV=test jest tests/unit --runInBand",
    "test:integration": "NODE_ENV=test jest tests/integration --runInBand",
    "test:db": "node scripts/test-db-connection.js",
    "test:db:local": "node scripts/test-db-connection.js .env.local",
    "lint": "echo 'Linting not configured yet'",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "pm2:stop": "pm2 stop lms-api",
    "pm2:restart": "pm2 restart lms-api",
    "pm2:logs": "pm2 logs lms-api",
    "pm2:monit": "pm2 monit"
  },
  "keywords": [
    "lms",
    "learning-management-system",
    "school-management",
    "education",
    "api",
    "nodejs",
    "express",
    "mongodb",
    "jwt",
    "rest-api",
    "authentication",
    "authorization"
  ],
  "author": "LMS Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/lms_node.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/lms_node/issues"
  },
  "homepage": "https://github.com/yourusername/lms_node#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dotenv-safe": "^9.1.0",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.26",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.0",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.1.4"
  }
}
